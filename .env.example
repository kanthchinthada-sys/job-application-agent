# Copy this file to .env and edit. .env is git-ignored: it never goes to GitHub.

# Turn on password protection (leave empty to keep it off)
APP_PASSWORD=

# INFO (default), DEBUG or WARNING
LOG_LEVEL=INFO

# Local AI (defaults shown). Docker sets OLLAMA_URL itself.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# Keep the summary in your own wording too (requires a verified experience bank).
# JOB_AGENT_EXACT_SUMMARY=off

# Find jobs: optional free Adzuna key for country-wide results from many job boards.
# Get one in 2 minutes at https://developer.adzuna.com (free tier), then fill both lines.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Find jobs: optional free JSearch key = LinkedIn, Indeed, Glassdoor (via Google for Jobs).
# Either an OpenWeb Ninja key (starts with "ak_"; free 100 requests/month at https://www.openwebninja.com,
# 1 per search) or a RapidAPI key (JSearch free Basic plan, 200 requests/month, 2 per search).
# JSEARCH_API_KEY=

# Find jobs: optional free Jooble key (many job boards, 60+ countries). Request one at https://jooble.org/api/about
# JOOBLE_API_KEY=

# Accounts (default on): everyone signs in and gets their own workspace. "off" = one shared workspace.
# JOB_AGENT_ACCOUNTS=on

# Adding a job: the local AI is asked only for fields the posting's data and rules couldn't find, in the
# background. Seconds per attempt, and how many more attempts after a timeout or an unusable answer.
# JOB_INTAKE_AI_TIMEOUT=45
# JOB_INTAKE_AI_RETRIES=1

# Find jobs: optional Apify search (PAID per result) for structured listings from employer career sites
# (Workday, Greenhouse, Lever, iCIMS, SuccessFactors ...). It runs only when you press "Search career sites
# (Apify)" in Find jobs. Token: https://console.apify.com/settings/integrations (keep it here, never in the browser).
# APIFY_API_TOKEN=
# The Actor to run (default: jobo.world/ats-jobs-api, the Career Site Jobs API; see docs/apify.md)
# APIFY_ACTOR_ID=jobo.world/ats-jobs-api
# Limits for each run: jobs returned, seconds before it is stopped, and the most it may charge (USD).
# APIFY_MAX_RESULTS=50
# APIFY_TIMEOUT_SECS=180
# APIFY_MAX_COST_USD=0.50
# A finished search with the same filters is reused for this many minutes instead of paying again.
# APIFY_REUSE_MINUTES=60
