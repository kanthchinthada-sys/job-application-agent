# Copy this file to .env and edit. .env is git-ignored: it never goes to GitHub.

# Turn on password protection (leave empty to keep it off)
APP_PASSWORD=

# INFO (default), DEBUG or WARNING
LOG_LEVEL=INFO

# Local AI (defaults shown). Docker sets OLLAMA_URL itself.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Find jobs: optional free Adzuna key for country-wide results from many job boards.
# Get one in 2 minutes at https://developer.adzuna.com (free tier), then fill both lines.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Find jobs: optional free JSearch key = LinkedIn, Indeed, Glassdoor (via Google for Jobs).
# Either an OpenWeb Ninja key (starts with "ak_"; free 100 requests/month at https://www.openwebninja.com,
# 1 per search) or a RapidAPI key (JSearch free Basic plan, 200 requests/month, 2 per search).
# JSEARCH_API_KEY=

# Find jobs: optional free Jooble key (many job boards, 60+ countries). Request one at https://jooble.org/api/about
# JOOBLE_API_KEY=
